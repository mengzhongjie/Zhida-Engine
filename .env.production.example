# 复制为 .env 后填写实际值。请勿提交 .env。
# 两个站点须为不同 HTTPS 域名，Cookie 才能以 host-only 方式隔离。
ZHIDA_TRUSTED_HOSTS=admin.example.com,app.example.com
ZHIDA_USER_APP_HOSTS=app.example.com
ZHIDA_CORS_ORIGINS=https://admin.example.com,https://app.example.com
ZHIDA_AUTH_SESSION_SECRET=replace-with-a-random-32-plus-character-secret
ZHIDA_AUTH_REQUIRE_HTTPS=true

# 2C2G 服务器使用云端模型，禁止因配置错误加载本地大型模型。
ZHIDA_EMBEDDING_MODE=cloud
ZHIDA_ENABLE_MINERU=false

# 可选：日志级别。生产默认 INFO。
ZHIDA_LOG_LEVEL=INFO
