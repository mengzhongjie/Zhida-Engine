<view class="page">
  <view style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx;">
    <view class="muted">仅显示当前已启用的助手</view>
    <view style="display: flex; align-items: center; color: #1677ff; font-size: 26rpx;">
      <view style="padding: 8rpx 16rpx;" bindtap="openHistory">历史对话</view>
      <view style="padding: 8rpx 16rpx;" bindtap="loadAgents">⟳ 刷新</view>
    </view>
  </view>
  <block wx:for="{{agents}}" wx:key="id">
    <view class="card" bindtap="openAgent" data-id="{{item.id}}" data-name="{{item.name}}">
      <view style="display: flex; align-items: center; font-size: 32rpx; font-weight: 600;">
        <image src="/images/zhida-logo.png" mode="aspectFill" style="width: 44rpx; height: 44rpx; border-radius: 10rpx; margin-right: 12rpx;" />
        <text>{{item.name}}</text>
      </view>
      <view class="muted" style="margin-top: 10rpx;">{{item.description || '暂无描述'}}</view>
    </view>
  </block>
  <view wx:if="{{!agents.length}}" class="card muted">暂无可用助手，请联系管理员。</view>
</view>
