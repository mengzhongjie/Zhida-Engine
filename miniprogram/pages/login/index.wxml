<view class="page">
  <view class="card">
    <view style="font-size: 40rpx; font-weight: 600; margin-bottom: 16rpx;">欢迎使用智答助手</view>
    <view class="muted">这是受邀用户专用服务，请输入管理员分发的邀请码。</view>
  </view>
  <view class="card">
    <input placeholder="请输入邀请码" value="{{inviteCode}}" bindinput="onInput" style="border: 1rpx solid #dbe3ef; border-radius: 12rpx; padding: 20rpx; margin-bottom: 24rpx;" />
    <view class="primary" bindtap="claim">激活并进入</view>
  </view>
</view>
