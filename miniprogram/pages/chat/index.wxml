<view class="chat-page">
  <!-- 导航栏 -->
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack">
      <text>‹ 返回</text>
    </view>
    <text class="nav-title">{{navTitle}}</text>
    <view class="nav-placeholder"></view>
  </view>

  <!-- 消息列表 -->
  <scroll-view class="message-list" scroll-y="true" scroll-into-view="{{scrollToId}}" scroll-with-animation="true">
    <block wx:for="{{messages}}" wx:key="index">
      <view class="msg-row {{item.role === 'user' ? 'msg-row-user' : 'msg-row-assistant'}}" id="msg-{{index}}">
        <view class="msg-avatar {{item.role === 'user' ? 'avatar-user' : 'avatar-assistant'}}">
          <text>{{item.role === 'user' ? '我' : 'AI'}}</text>
        </view>
        <view class="msg-bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-assistant'}}">
          <block wx:if="{{item.role === 'assistant' && item.blocks && item.blocks.length}}">
            <block wx:for="{{item.blocks}}" wx:key="index" wx:for-item="block">
              <view wx:if="{{block.type === 'heading1'}}" class="md-heading md-heading-1">{{block.text}}</view>
              <view wx:elif="{{block.type === 'heading2'}}" class="md-heading md-heading-2">{{block.text}}</view>
              <view wx:elif="{{block.type === 'heading3'}}" class="md-heading md-heading-3">{{block.text}}</view>
              <view wx:elif="{{block.type === 'list'}}" class="md-list"><text class="md-list-mark">{{block.ordered ? '▸' : '•'}}</text><text>{{block.text}}</text></view>
              <view wx:elif="{{block.type === 'code'}}" class="md-code">{{block.text}}</view>
              <text wx:else class="msg-content">{{block.text}}</text>
            </block>
          </block>
          <text wx:else class="msg-content">{{item.content}}</text>
          <text wx:if="{{item.showCursor}}" class="typing-cursor">|</text>
          <view wx:if="{{item.sources && item.sources.length}}" class="source-list">
            <text class="source-label">参考来源</text>
            <block wx:for="{{item.sources}}" wx:key="index" wx:for-item="source">
              <view class="source-chip">{{source.metadata.section_title || source.metadata.filename || '知识库片段'}}</view>
            </block>
          </view>
        </view>
      </view>
    </block>
    <view wx:if="{{loadingAnswer}}" class="msg-row msg-row-assistant">
      <view class="msg-avatar avatar-assistant"><text>AI</text></view>
      <view class="msg-bubble bubble-assistant">
        <text class="typing-dots">思考中<span class="dot-anim">...</span></text>
      </view>
    </view>
    <!-- 占位让输入框不遮挡 -->
    <view style="height: 140rpx;"></view>
  </scroll-view>

  <!-- 底部输入区（fixed） -->
  <view class="input-area">
    <textarea class="input-textarea" value="{{question}}" bindinput="onInput" placeholder="输入问题..." maxlength="1000" auto-height bindconfirm="ask" confirm-type="send" />
    <view class="send-btn {{question ? 'send-active' : ''}}" bindtap="ask">发送</view>
  </view>
</view>
