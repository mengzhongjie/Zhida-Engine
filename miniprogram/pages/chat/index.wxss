/* 页面容器 */
.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f5f7fb;
}

/* 导航栏 */
.nav-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
  background: #ffffff;
  border-bottom: 1rpx solid #eee;
  flex-shrink: 0;
}
.nav-back {
  padding: 12rpx 16rpx;
  color: #1677ff;
  font-size: 28rpx;
}
.nav-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}
.nav-placeholder {
  width: 80rpx;
}

/* 消息列表 */
.message-list {
  flex: 1;
  overflow-y: auto;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
}

/* 消息行 */
.msg-row {
  display: flex;
  margin-bottom: 28rpx;
  align-items: flex-start;
}
.msg-row-user {
  flex-direction: row-reverse;
}

/* 头像 */
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: #fff;
  flex-shrink: 0;
}
.avatar-user {
  background: #1677ff;
  margin-left: 16rpx;
}
.avatar-assistant {
  background: #52c41a;
  margin-right: 16rpx;
}

/* 气泡 */
.msg-bubble {
  max-width: 560rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-word;
}
.bubble-user {
  background: #1677ff;
  color: #fff;
  border-bottom-right-radius: 4rpx;
}
.bubble-assistant {
  background: #ffffff;
  color: #333;
  border-bottom-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.msg-content {
  white-space: pre-wrap;
}

/* 打字光标 */
.typing-cursor {
  color: #1677ff;
  animation: blink 0.8s infinite;
}
@keyframes blink {
  0%, 50% { opacity: 1; }
  51%, 100% { opacity: 0; }
}

/* 思考中动画 */
.typing-dots {
  color: #999;
  font-size: 26rpx;
}
.dot-anim {
  animation: dotPulse 1.2s infinite;
  display: inline-block;
}
@keyframes dotPulse {
  0% { opacity: 0.2; }
  50% { opacity: 1; }
  100% { opacity: 0.2; }
}

/* 底部输入区（fixed） */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  padding: 16rpx 24rpx;
  padding-bottom: env(safe-area-inset-bottom, 16rpx);
  background: #ffffff;
  border-top: 1rpx solid #eee;
  z-index: 10;
}
.input-textarea {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  padding: 16rpx 20rpx;
  background: #f5f5f5;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.5;
  box-sizing: border-box;
}
.send-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 16rpx 32rpx;
  background: #e8e8e8;
  color: #999;
  border-radius: 12rpx;
  font-size: 28rpx;
  text-align: center;
  line-height: 1.5;
}
.send-active {
  background: #1677ff;
  color: #fff;
}
