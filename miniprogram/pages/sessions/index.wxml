<view class="page">
  <view class="page-heading">历史对话</view>
  <view class="muted page-subtitle">选择一段对话继续提问</view>

  <view wx:if="{{loading}}" class="card muted">正在加载…</view>
  <block wx:else>
    <block wx:for="{{sessions}}" wx:key="id">
      <view class="card session-card" bindtap="openSession" data-id="{{item.id}}" data-agent-id="{{item.agent_id}}" data-name="{{item.agentName}}">
        <view class="session-topline">
          <view class="session-agent">{{item.agentName}}</view>
          <view class="session-time">{{item.displayTime}}</view>
        </view>
        <view class="session-title">{{item.title || '未命名对话'}}</view>
        <view class="continue-text">继续对话 ›</view>
      </view>
    </block>
  </block>

  <view wx:if="{{!loading && !sessions.length}}" class="card empty-state">
    <view class="empty-title">还没有历史对话</view>
    <view class="muted">选择一个助手并提出第一个问题吧。</view>
  </view>
</view>
