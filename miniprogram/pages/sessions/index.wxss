.history-header { display: flex; align-items: center; gap: 16rpx; }
.back-button { color: #58718f; font-size: 26rpx; padding: 8rpx 4rpx; }
.page-heading { font-size: 40rpx; font-weight: 700; color: #17233d; }
.page-subtitle { margin: 10rpx 0 28rpx; }
.session-card { position: relative; }
.session-topline { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.session-agent { color: #1677ff; font-size: 24rpx; font-weight: 600; }
.session-time { color: #98a4b5; font-size: 22rpx; }
.session-title { padding-right: 100rpx; color: #243653; font-size: 30rpx; font-weight: 600; line-height: 1.5; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.continue-text { position: absolute; right: 28rpx; bottom: 30rpx; color: #7890ae; font-size: 23rpx; }
.empty-state { padding: 90rpx 30rpx; text-align: center; }
.empty-title { margin-bottom: 12rpx; color: #243653; font-size: 30rpx; font-weight: 600; }
