# ---- 认证与会话（必填） ----
# 首次启动用于创建管理员账号。生产环境必须改为强密码（至少 12 位）。
# 若留空或使用弱密码（如 123456），生产模式（DEBUG=false）会自动生成随机密码并仅打印在控制台。
ZHIDA_ADMIN_BOOTSTRAP_USERNAME=admin
ZHIDA_ADMIN_BOOTSTRAP_PASSWORD=replace-with-a-strong-password
# 会话签名密钥，至少 32 字符，务必使用随机字符串。
ZHIDA_AUTH_SESSION_SECRET=replace-with-a-long-random-secret

# ---- 部署 ----
# 生产必须保持 DEBUG=false，否则 Swagger 文档与调试信息会暴露。
ZHIDA_DEBUG=false
# HTTPS 域名；与反向代理的 Host 和管理台访问地址一致。
ZHIDA_TRUSTED_HOSTS=zhida.example.com
ZHIDA_CORS_ORIGINS=https://zhida.example.com
# 仅含用户对话功能的独立用户站主机名（可选，与 admin 站分开时设置）。
# ZHIDA_USER_APP_HOSTS=user.example.com

# ---- 向量化（云端，OpenAI 兼容）----
ZHIDA_EMBEDDING_MODE=cloud
# ZHIDA_EMBEDDING_CLOUD_BASE_URL=https://api.siliconflow.cn/v1
# ZHIDA_EMBEDDING_CLOUD_API_KEY=sk-your-key
# ZHIDA_EMBEDDING_CLOUD_MODEL=BAAI/bge-large-zh-v1.5

# ---- 可选：RAG 未命中时联网检索 ----
# ZHIDA_WEB_SEARCH_ENABLED=true
# ZHIDA_WEB_SEARCH_PROVIDER=tavily
# ZHIDA_WEB_SEARCH_API_KEY=tvly-your-key
