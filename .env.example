# CloudBase 云函数与后端共同使用的随机密钥，建议至少 32 字符。
ZHIDA_MINIPROGRAM_GATEWAY_SECRET=replace-with-a-long-random-secret
# 首位管理员的微信 OpenID；多个管理员用英文逗号分隔。
ZHIDA_ADMIN_OPENIDS=replace-with-your-wechat-openid

# 仅本地小程序联调：设置 DEBUG=true 后，填入与 miniprogram/app.js 相同的测试 OpenID。
# 生产环境不要设置此项，并保持 ZHIDA_DEBUG=false。
# ZHIDA_DEBUG=true
# ZHIDA_MINIPROGRAM_DEV_OPENID=local-wechat-test-user
