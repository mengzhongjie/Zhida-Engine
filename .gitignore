*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.eggs/
*.manifest
*.spec

# ---- 虚拟环境 ----
venv/
.venv/
env/
.env
*.env.local

# ---- IDE ----
.idea/
.vscode/
.trae/
*.swp
*.swo
*~

# ---- 操作系统 ----
.DS_Store
Thumbs.db
Desktop.ini

# ---- 日志 ----
*.log

